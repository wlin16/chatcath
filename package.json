{
  "name": "chatcath",
  "version": "0.1.0",
  "private": true,
  "description": "ChatCath — a DeepSeek Harness (dsh) profile for protein/biotech work: curated plugins + compatibility patches. Clone, pnpm install, pnpm dsh web.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dsh": "node scripts/dsh.mjs",
    "patch": "node scripts/patch.mjs",
    "postinstall": "node scripts/patch.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.2-rc.1",
    "@deepseek-ai/dsh-spill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": "0.1.2-rc.1",
    "@linxin666/dsh-client-ui-task-board": "0.3.13",
    "@michengai/dsh-agency-agents": "0.1.30",
    "@michengai/dsh-archive-manager": "0.1.29",
    "@michengai/dsh-automation": "0.1.27",
    "@michengai/dsh-codex-ui": "0.2.102",
    "@michengai/dsh-im-connect": "0.1.34",
    "@michengai/dsh-skills-manager": "0.1.38",
    "@studyzy/dsh-suggest-prompt": "1.0.1",
    "dsh-artifact-viewer": "workspace:*",
    "dsh-better-sidebar": "0.18.0",
    "dsh-find-plugin": "0.3.7",
    "dsh-plugin-message-edit": "1.0.0",
    "dsh-plugin-subscriptions": "0.6.0",
    "dsh-protein-cards": "workspace:*",
    "dsh-ssh-ops": "0.2.20",
    "dshmarket": "1.41.0",
    "scheduler": "0.27.0"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-find-plugin",
        "dshmarket",
        "dsh-better-sidebar",
        "@linxin666/dsh-client-ui-task-board",
        "@michengai/dsh-codex-ui",
        "dsh-plugin-subscriptions",
        "dsh-ssh-ops",
        "@michengai/dsh-skills-manager",
        "@michengai/dsh-agency-agents",
        "@michengai/dsh-archive-manager",
        "@michengai/dsh-automation",
        "@michengai/dsh-im-connect",
        "dsh-protein-cards",
        "dsh-artifact-viewer",
        "dsh-plugin-message-edit",
        "@studyzy/dsh-suggest-prompt"
      ]
    }
  },
  "chatcath": {
    "peerShims": [
      "@deepseek-ai/cordis-plugin-group",
      "@deepseek-ai/dsh-anonymous-user-id",
      "@deepseek-ai/dsh-attachment",
      "@deepseek-ai/dsh-authorization",
      "@deepseek-ai/dsh-bash-local",
      "@deepseek-ai/dsh-code-runtime",
      "@deepseek-ai/dsh-compaction",
      "@deepseek-ai/dsh-fs",
      "@deepseek-ai/dsh-hook-protocol",
      "@deepseek-ai/dsh-jobs",
      "@deepseek-ai/dsh-output-retention",
      "@deepseek-ai/dsh-sandbox",
      "@deepseek-ai/dsh-sdk-protocol",
      "@deepseek-ai/dsh-session-persistence",
      "@deepseek-ai/dsh-session-query",
      "@deepseek-ai/dsh-session-telemetry",
      "@deepseek-ai/dsh-session-title-llm",
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/dsh-shell",
      "@deepseek-ai/dsh-spill",
      "@deepseek-ai/dsh-subagent-in-process-driver",
      "@deepseek-ai/dsh-util-time",
      "@deepseek-ai/dsh-util-workspace-path",
      "@deepseek-ai/dsh-workflow",
      "scheduler"
    ],
    "note": "peerShims: peer deps of the dsh core that a global npm install satisfies implicitly; pnpm (autoInstallPeers: false) needs them listed. Keep versions in step with @deepseek-ai/dsh."
  }
}
